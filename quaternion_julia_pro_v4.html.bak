<!DOCTYPE html>
<html lang="fa">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>Quaternion Julia v4 — دموی تعاملی</title>
<meta name="description" content="دموی تعاملی مجموعه‌ی جولیا در فضای کواترنیون با Sphere Tracing در WebGL">
<meta name="theme-color" content="#000000">
<meta property="og:title" content="Quaternion Julia">
<meta property="og:description" content="مجموعه‌ی جولیا در فضای کواترنیون، زنده و تعاملی">
<meta property="og:type" content="website">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%23000'/%3E%3Ccircle cx='32' cy='32' r='18' fill='none' stroke='%239fe6cf' stroke-width='3'/%3E%3Ccircle cx='46' cy='20' r='5' fill='%239fe6cf'/%3E%3C/svg%3E">
<style>
  :root { --fg:#d8d4e8; --dim:#8f8aa6; --line:rgba(190,175,255,.26); --panel:rgba(10,9,16,.93);
          --acc:#9fe6cf; --warn:#ffbd73; --bad:#ff8f9d; }
  * { box-sizing: border-box; }
  html, body { margin:0; height:100%; background:#000; color:var(--fg); overflow:hidden;
    font:14px/1.55 "Vazirmatn", Tahoma, "Segoe UI", system-ui, sans-serif;
    -webkit-user-select:none; user-select:none; -webkit-text-size-adjust:100%; touch-action:manipulation; }
  #c { position:fixed; inset:0; width:100vw; height:100vh; background:#000; display:block; touch-action:none;
       transition: width .12s linear, height .12s linear; }

  button, select { font:inherit; color:var(--fg); background:rgba(22,20,34,.85); border:1px solid var(--line);
    border-radius:7px; padding:7px 12px; cursor:pointer; }
  button:hover, select:hover { border-color:rgba(190,175,255,.7); }
  button:focus-visible, select:focus-visible, input:focus-visible, summary:focus-visible { outline:2px solid var(--acc); outline-offset:2px; }
  button.primary { background:var(--acc); color:#08130f; border-color:var(--acc); font-weight:600; }
  button.primary:hover { filter:brightness(1.08); }
  button:disabled { opacity:.4; cursor:default; }

  /* toolbar: now always visible — no fade timer */
  #bar { position:fixed; left:10px; top:10px; right:10px; display:flex; gap:6px; flex-wrap:wrap; z-index:5;
         direction:ltr; }
  #bar.hidden-bench { display:none; }
  #foot { position:fixed; left:0; right:0; bottom:30px; z-index:3; text-align:center; direction:rtl;
          font-size:11px; line-height:1.5; color:var(--dim); opacity:.75; pointer-events:none; padding:0 12px; }
  #hud { position:fixed; right:12px; bottom:10px; z-index:4; font:12px/1.4 ui-monospace, Menlo, Consolas, monospace;
         color:var(--dim); direction:ltr; pointer-events:none; }

  .panel { position:fixed; left:10px; top:56px; width:min(470px, calc(100vw - 20px)); max-height:calc(100vh - 72px);
           overflow:auto; background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:14px 16px;
           z-index:6; display:none; -webkit-user-select:text; user-select:text; }
  .panel.open { display:block; }
  .panel h2, .card h2 { margin:0 0 8px; font-size:16px; font-weight:600; }
  .row { display:flex; justify-content:space-between; align-items:center; gap:12px; margin:9px 0; }
  .row > span { flex:1; }
  .row input[type=range] { width:48%; accent-color:var(--acc); }
  .row input[type=checkbox] { width:18px; height:18px; accent-color:var(--acc); }
  .note { color:var(--dim); font-size:12.5px; margin:6px 0; }
  .heavy { color:var(--warn); font-size:12.5px; margin:6px 0; min-height:1em; }
  .hidden { display:none !important; }
  .chk { display:flex; flex-wrap:wrap; gap:6px 14px; margin:6px 0 10px; }
  .chk label { display:flex; align-items:center; gap:6px; }
  details { margin-top:12px; border-top:1px solid var(--line); padding-top:10px; }
  summary { cursor:pointer; color:var(--dim); }
  #kernel { width:100%; height:260px; resize:vertical; margin-top:8px; background:#050408; color:#e8e3f7;
            border:1px solid var(--line); border-radius:6px; padding:8px; direction:ltr; text-align:left; tab-size:2;
            font:12px/1.45 ui-monospace, Menlo, Consolas, monospace; -webkit-user-select:text; user-select:text; }
  #klog { white-space:pre-wrap; font:12px/1.4 ui-monospace, Menlo, monospace; color:#8fe0b0; margin:6px 0 0; direction:ltr; text-align:left; }
  #klog.err { color:var(--bad); }
  pre#resText { direction:ltr; text-align:left; white-space:pre; overflow:auto; font:12px/1.5 ui-monospace, Menlo, Consolas, monospace;
                background:#050408; border:1px solid var(--line); border-radius:6px; padding:10px; margin:8px 0; }
  .btns { display:flex; gap:8px; flex-wrap:wrap; margin-top:12px; }

  #warn { position:fixed; inset:0; z-index:20; background:#000; display:flex; align-items:center; justify-content:center; padding:16px; overflow:auto; }
  .card { width:min(520px, 100%); background:#0c0b12; border:1px solid var(--line); border-radius:12px; padding:20px 22px; }
  .card ul { margin:8px 0 14px; padding-inline-start:20px; }
  .card li { margin:5px 0; }
  .card .lead { margin:0 0 4px; }
  .card select { width:100%; margin:6px 0 4px; }

  #test { position:fixed; left:50%; bottom:16px; transform:translateX(-50%); z-index:7; width:min(500px, calc(100vw - 20px));
          background:var(--panel); border:1px solid var(--line); border-radius:10px; padding:12px 14px; display:none; text-align:center; }
  #test.open { display:block; }
  #chart { width:100%; height:90px; display:none; margin-bottom:6px; }
  #testText { font:13px/1.5 ui-monospace, Menlo, Consolas, monospace; margin-bottom:8px; direction:ltr; }
  #prog { height:4px; background:rgba(255,255,255,.1); border-radius:2px; overflow:hidden; margin-bottom:10px; }
  #prog i { display:block; height:100%; width:0; background:var(--acc); }

  #toast { position:fixed; left:50%; top:56px; transform:translateX(-50%); z-index:30; max-width:min(520px, calc(100vw - 24px));
           background:#17141f; border:1px solid var(--warn); color:var(--fg); border-radius:8px; padding:10px 14px; display:none; text-align:center; }
  #toast.open { display:block; }
  #toast.bad { border-color:var(--bad); }

  /* preset warning banner */
  #presetWarn { position:fixed; left:50%; top:56px; transform:translateX(-50%); z-index:25;
    width:min(620px, calc(100vw - 24px)); border-radius:10px; padding:12px 16px; display:none;
    background:rgba(40, 30, 10, .96); border:1px solid var(--warn); color:var(--fg);
    box-shadow:0 8px 24px rgba(0,0,0,.5); direction:ltr; }
  #presetWarn.open { display:flex; gap:12px; align-items:center; }
  #presetWarn.lvl-high { background:rgba(50,35,10,.96); border-color:var(--warn); }
  #presetWarn.lvl-ultra { background:rgba(60,25,15,.96); border-color:#ff9e5a; }
  #presetWarn.lvl-extreme { background:rgba(70,15,20,.97); border-color:var(--bad); }
  #presetWarn .pw-icon { font-size:22px; flex:0 0 auto; }
  #presetWarn .pw-body { flex:1; min-width:0; }
  #presetWarn .pw-title { font-weight:600; margin-bottom:2px; }
  #presetWarn .pw-text { font-size:12.5px; color:#e9e5f5; }
  #presetWarn .pw-close { background:transparent; border:1px solid rgba(255,255,255,.25); padding:4px 9px;
    border-radius:6px; color:#fff; font-size:16px; line-height:1; cursor:pointer; flex:0 0 auto; }
  #presetWarn .pw-close:hover { background:rgba(255,255,255,.1); }
</style>
</head>
<body>
<canvas id="c"></canvas>

<div id="bar">
  <button id="bSettings" data-i18n="bSettings"></button>
  <button id="bBench" data-i18n="bBench"></button>
  <button id="bPause"></button>
  <button id="bReset" data-i18n="bReset"></button>
  <button id="bShot" data-i18n="bShot"></button>
  <button id="bFull" data-i18n="bFull"></button>
  <button id="bLang">EN</button>
</div>
<div id="hud"></div>
<div id="foot">برای چرخاندن یک انگشت را بکشید؛ برای زوم دو انگشت را باز و بسته کنید.</div>

<!-- Preset warning banner -->
<div id="presetWarn">
  <div class="pw-icon" id="pwIcon">⚠️</div>
  <div class="pw-body">
    <div class="pw-title" id="pwTitle"></div>
    <div class="pw-text" id="pwText"></div>
  </div>
  <button class="pw-close" id="pwClose" aria-label="close">✕</button>
</div>

<!-- Settings -->
<div id="pSettings" class="panel">
  <h2 data-i18n="sTitle"></h2>
  <div class="row"><span data-i18n="sQuality"></span><select id="sQuality"></select></div>
  <div class="note" id="sDesc"></div>
  <div class="heavy" id="sHeavy"></div>
  <div class="row"><span data-i18n="sRes"></span><select id="sRes"></select></div>
  <div class="row"><span data-i18n="sFps"></span><select id="sFps"></select></div>
  <div class="row"><span data-i18n="sMorph"></span><input type="range" id="sMorph" min="0" max="3" step="0.05" value="1"></div>
  <div class="row"><span data-i18n="sSpin"></span><input type="range" id="sSpin" min="0" max="0.6" step="0.01" value="0.15"></div>
  <div class="row"><span data-i18n="sGlow"></span><input type="checkbox" id="sGlow" checked></div>
  <div class="row"><span data-i18n="sGloss"></span><input type="range" id="sGloss" min="0" max="2" step="0.05" value="1"></div>
  <div class="row"><span data-i18n="sShowFps"></span><input type="checkbox" id="sShowFps" checked></div>
  <div class="note" data-i18n="sZoomHint"></div>
  <details>
    <summary data-i18n="sKernel"></summary>
    <textarea id="kernel" spellcheck="false"></textarea>
    <div class="btns"><button id="kApply" data-i18n="sApply"></button><button id="kReset" data-i18n="sKReset"></button></div>
    <pre id="klog"></pre>
  </details>
  <div class="btns"><button id="sClose" data-i18n="bClose"></button></div>
</div>

<!-- Benchmark -->
<div id="pBench" class="panel">
  <h2 data-i18n="bTitle"></h2>
  <div class="note" id="gpuLine"></div>

  <div id="bSetup">
    <div class="row"><span data-i18n="bType"></span>
      <select id="bTypeSel"><option value="bench"></option><option value="stress"></option></select></div>

    <div id="secBench">
      <div class="note" data-i18n="bPresets"></div>
      <div class="chk" id="bPresetChecks"></div>
      <div class="row"><span data-i18n="bDur"></span><select id="bDur"></select></div>
    </div>
    <div id="secStress" class="hidden">
      <div class="row"><span data-i18n="bStressPreset"></span><select id="bsPreset"></select></div>
      <div class="row"><span data-i18n="bStressDur"></span><select id="bsDur"></select></div>
    </div>
    <div class="row"><span data-i18n="bRes"></span>
      <select id="bRes"><option value="1280x720">1280 × 720</option><option value="1920x1080">1920 × 1080</option><option value="2560x1440">2560 × 1440</option></select></div>
    <div class="note" data-i18n="bNote"></div>
    <div class="btns"><button class="primary" id="bStart" data-i18n="bStart"></button></div>
  </div>

  <div id="bResults" class="hidden">
    <h2 data-i18n="bResults"></h2>
    <pre id="resText"></pre>
    <div class="note" id="verdict"></div>
    <div class="btns">
      <button id="bCopy" data-i18n="bCopy"></button>
      <button id="bSave" data-i18n="bSave"></button>
      <button id="bAgain" data-i18n="bAgain"></button>
    </div>
  </div>
  <div class="btns"><button id="bCloseBench" data-i18n="bClose"></button></div>
</div>

<!-- Running test HUD -->
<div id="test">
  <canvas id="chart" width="480" height="90"></canvas>
  <div id="testText"></div>
  <div id="prog"><i></i></div>
  <button id="bStop" data-i18n="bStop"></button>
</div>

<!-- Warning dialog -->
<div id="warn">
  <div class="card">
    <h2 data-i18n="wTitle"></h2>
    <p class="lead" data-i18n="wLead"></p>
    <ul>
      <li data-i18n="w1"></li><li data-i18n="w2"></li><li data-i18n="w3"></li><li data-i18n="w4"></li>
    </ul>
    <div class="note" id="wBatt"></div>
    <div><span data-i18n="wQuality"></span> <span class="note" id="wSug"></span></div>
    <select id="wQualitySel"></select>
    <div class="btns">
      <button class="primary" id="wStart" data-i18n="wStart"></button>
      <button id="wLang">EN</button>
    </div>
  </div>
</div>

<div id="toast"></div>

<script>
"use strict";

/* =====================================================================
   Animated quaternion Julia set — sphere-traced distance estimator.
   Quality presets drive: fractal iterations, march steps, shadows,
   ambient occlusion, anti-aliasing, surface detail, self-reflection AND
   the geometric complexity of the underlying fractal itself (uComplex).
   Each preset also has its own animation personality.
   ===================================================================== */

const DEFAULT_KERNEL = `// Quaternion Julia set  z -> z^2 + c  sliced at a moving 4th coordinate.
// v2: bigger, lopsided and wildly warped. The shape is stretched unevenly,
// pushed through several layers of domain warping and twisting, and c(t)
// roams further so tendrils, holes and blobs keep appearing and dissolving.
// Higher presets (uComplex) add more warp layers. Distance is divided by an
// estimated Lipschitz constant ("lip") so the ray marcher stays stable.
const float SC = 1.42;            // overall size of the shape (bigger = larger)

vec4 qsqr(vec4 q) {
  return vec4(q.x * q.x - dot(q.yzw, q.yzw), 2.0 * q.x * q.yzw);
}

vec3 twistAxis(vec3 p, vec3 axis, float k) {
  float a = k * dot(p, axis);
  float cs = cos(a), sn = sin(a);
  return p * cs + cross(axis, p) * sn + axis * dot(axis, p) * (1.0 - cs);
}

float map(vec3 P) {
  float s = time * 0.2;
  float cxf = float(uComplex);
  float wk = 0.6 + 0.1 * cxf;     // warp strength grows with preset
  float lip = 1.0;

  vec3 p = P / SC;

  // lopsided, breathing stretch + drifting centre (kills the symmetry)
  vec3 sc = vec3(1.0 + 0.22 * sin(s * 0.7),
                 1.0 - 0.15 * cos(s * 0.55 + 1.0),
                 1.0 + 0.18 * sin(s * 0.45 + 2.0));
  p *= sc;
  lip *= max(sc.x, max(sc.y, sc.z));
  p += 0.12 * vec3(sin(s * 0.9), cos(s * 0.7), sin(s * 0.5 + 1.0));

  // twists around different axes
  p = twistAxis(p, normalize(vec3(0.0, 1.0, 0.0)), 0.55 * sin(s * 0.8));
  lip += 0.10;
  if (uComplex >= 1) {
    p = twistAxis(p, normalize(vec3(1.0, 0.3, -0.5)), 0.70 * sin(s * 1.1 + 0.7));
    lip += 0.10;
  }
  if (uComplex >= 2) {
    p = twistAxis(p, normalize(vec3(-0.4, 1.0, 0.6)), 0.80 * cos(s * 0.9 + 1.3));
    lip += 0.10;
  }

  // domain warping, coarse to fine
  p += 0.11 * wk * sin(p.yzx * 2.3 + s * vec3(1.1, 0.9, 1.3));
  lip += 0.13 * wk;
  if (uComplex >= 1) {
    p += 0.06 * wk * sin(p.zxy * 4.1 - s * vec3(1.4, 1.0, 1.7) + 1.7);
    lip += 0.12 * wk;
  }
  if (uComplex >= 2) {
    p += 0.03 * wk * sin(p.yzx * 7.3 + s * vec3(2.1, 1.6, 2.5));
    lip += 0.11 * wk;
  }
  if (uComplex >= 3) {
    p += 0.016 * wk * sin(p.zxy * 13.1 - s * vec3(2.8, 2.2, 3.1));
    lip += 0.10 * wk;
  }
  if (uComplex >= 4) {
    float r = length(p);
    p *= 1.0 + 0.07 * sin(r * 7.0 - s * 2.4);
    p = twistAxis(p, normalize(vec3(0.7, -0.5, 0.9)), 0.80 * sin(s * 0.4 + r * 1.5));
    lip += 0.24;
  }

  // c(t): roams wider than before, with extra harmonics for higher presets
  vec4 c = vec4(0.50, 0.58, 0.56, 0.50)
         * cos(vec4(0.5, 3.9, 1.4, 1.1) + s * vec4(1.2, 1.7, 1.3, 2.5))
         - vec4(0.32, -0.05, 0.0, 0.0);
  c += 0.06 * sin(vec4(2.0, 1.0, 3.0, 4.0) * s * 2.3 + vec4(0.0, 1.0, 2.0, 3.0));
  if (uComplex >= 2) {
    c += 0.05 * cos(vec4(5.0, 4.0, 6.0, 3.5) * s * 1.7 + vec4(1.0, 0.5, 2.0, 1.5));
  }
  if (uComplex >= 3) {
    c.w += 0.04 * sin(s * 5.0) * cos(s * 2.3);
    c.xyz += 0.025 * vec3(sin(s * 7.0), cos(s * 6.0), sin(s * 8.0));
  }
  if (uComplex >= 4) {
    c *= 1.0 + 0.08 * sin(s * 3.1 + c.y * 4.0);
    c.w += 0.025 * sin(s * 11.0) * cos(s * 9.0);
  }
  // keep c from drifting so far that the whole set shatters into dust
  float ci = length(c.yzw);
  if (ci > 0.85) c.yzw *= 0.85 / ci;

  // 4th coordinate: bigger slice motion + a position-dependent lump
  float w = 0.26 * sin(s * 0.9) + 0.07 * sin(s * 2.7);
  if (uComplex >= 1) w += 0.03 * cos(s * 4.1);
  if (uComplex >= 3) w += 0.02 * sin(s * 7.3);
  w += 0.10 * wk * sin(P.x * 2.0 + P.y * 1.5 + s * 1.3);
  lip += 0.10;
  w *= mix(1.0, 1.6, uPresetT);
  p *= 1.0 + 0.03 * uPresetT * sin(s * 3.0 + length(p));

  vec4 z = vec4(p, w);

  float md2 = 1.0;
  float mz2 = dot(z, z);
  vec4 trap = vec4(abs(z.xyz), mz2);
  float n = 1.0;

  for (int i = 0; i < 16; i++) {
    if (i >= uIter) break;
    md2 *= 4.0 * mz2;
    z = qsqr(z) + c;
    trap = min(trap, vec4(abs(z.xyz), dot(z, z) / (n * n)));
    mz2 = dot(z, z);
    if (mz2 > 4.0) break;
    n += 1.0;
  }
  gTrap = trap;
  return 0.9 * 0.25 * sqrt(mz2 / md2) * log(mz2) * SC / lip;
}
`;

const VS = `
attribute vec2 position;
uniform vec3 right, forward, up;
uniform float aspect;
uniform vec2 pix;
varying vec3 dir, dx, dy;
void main() {
  gl_Position = vec4(position, 0.0, 1.0);
  vec3 r = right * aspect;
  dir = forward * 1.6 + r * position.x + up * position.y;
  dx = r * pix.x;
  dy = up * pix.y;
}`;

const FS_HEAD = `
#ifdef GL_FRAGMENT_PRECISION_HIGH
precision highp float;
#else
precision mediump float;
#endif
uniform vec3 origin;
uniform float time, uEps, uGlow, uPresetT, uGloss;
uniform int uIter, uSteps, uShadow, uAO, uAA, uDetail, uRefl, uComplex;
varying vec3 dir, dx, dy;

vec4 gTrap;
float map(vec3 p);

const int   MAXS = 320;
const float BOUND = 3.0;

vec3 palette(vec4 tr) {
  float k = 0.35 * tr.w + 0.5 * tr.y + 0.4 * tr.z;
  vec3 a = 0.5 + 0.5 * cos(6.2832 * (k * 1.6 + vec3(0.0, 0.33, 0.67) + time * 0.05) + vec3(0.0, 0.5, 1.0));
  vec3 b = 0.5 + 0.5 * cos(6.2832 * (tr.x * 1.2 + tr.w * 0.8 + vec3(0.1, 0.4, 0.55) - time * 0.03));
  vec3 c = mix(a, b, 0.4 + 0.3 * sin(tr.z * 5.0 + time * 0.3));
  float l = dot(c, vec3(0.299, 0.587, 0.114));
  return clamp(mix(vec3(l), c, 1.6), 0.0, 1.0);
}

vec3 calcNormal(vec3 p, float t) {
  float e = max(0.5 * uEps * t, 0.0002);
  vec2 k = vec2(1.0, -1.0);
  return normalize(k.xyy * map(p + k.xyy * e) +
                   k.yyx * map(p + k.yyx * e) +
                   k.yxy * map(p + k.yxy * e) +
                   k.xxx * map(p + k.xxx * e));
}

float softShadow(vec3 ro, vec3 rd) {
  float res = 1.0;
  float t = 0.012;
  for (int i = 0; i < 64; i++) {
    if (i >= uShadow) break;
    float h = map(ro + rd * t);
    res = min(res, 8.0 * h / t);
    t += clamp(h, 0.01, 0.2);
    if (res < 0.002 || t > 3.0) break;
  }
  return clamp(res, 0.0, 1.0);
}

float calcAO(vec3 p, vec3 n) {
  float occ = 0.0;
  float sca = 1.0;
  for (int i = 0; i < 8; i++) {
    if (i >= uAO) break;
    float h = 0.01 + 0.07 * float(i) * (5.0 / float(uAO));
    float d = map(p + n * h);
    occ += (h - d) * sca;
    sca *= 0.85;
  }
  return clamp(1.0 - 3.0 * occ * (5.0 / float(uAO)) * 0.5, 0.0, 1.0);
}

vec3 lightDir() {
  float a = time * 0.25;
  return normalize(vec3(0.8 * cos(a), 0.8, 0.8 * sin(a)));
}

// Procedural studio environment: soft boxes, a light strip and a rainbow
// horizon band. It is fixed in the world, so as the camera orbits the shape
// the reflections sweep across the surface.
vec3 envMap(vec3 r) {
  float a = time * 0.12;
  float ca = cos(a), sa = sin(a);
  r = vec3(ca * r.x - sa * r.z, r.y, sa * r.x + ca * r.z);
  vec3 col = mix(vec3(0.02, 0.025, 0.06), vec3(0.16, 0.20, 0.38), smoothstep(-0.5, 0.9, r.y));
  float az = atan(r.z, r.x);
  vec3 band = 0.5 + 0.5 * cos(6.2832 * (az * 0.159155 + vec3(0.0, 0.33, 0.67)) + time * 0.3);
  col += band * pow(1.0 - abs(r.y), 10.0) * 0.55;
  col += vec3(1.00, 0.93, 0.82) * smoothstep(0.90, 0.985, dot(r, normalize(vec3(0.55, 0.65, 0.35)))) * 5.0;
  col += vec3(1.00, 0.30, 0.65) * smoothstep(0.93, 0.99, dot(r, normalize(vec3(-0.85, 0.25, 0.45)))) * 4.0;
  col += vec3(0.25, 0.80, 1.00) * smoothstep(0.93, 0.99, dot(r, normalize(vec3(0.15, -0.35, -0.92)))) * 4.0;
  col += vec3(0.80, 1.00, 0.45) * smoothstep(0.95, 0.99, dot(r, normalize(vec3(-0.3, 0.9, -0.3)))) * 3.0;
  float strip = smoothstep(0.035, 0.0, abs(dot(r, vec3(0.8, 0.0, 0.6)) - 0.15)) * smoothstep(-0.1, 0.4, r.y);
  col += vec3(1.0, 0.97, 0.9) * strip * 3.5;
  return col;
}

vec3 bgColor(vec3 rd) {
  float g = 0.5 + 0.5 * rd.y;
  vec3 a = 0.5 + 0.5 * cos(6.2832 * (vec3(0.0, 0.33, 0.67) + rd.y * 0.3 + rd.x * 0.25 + time * 0.02));
  float haze = pow(max(dot(rd, lightDir()), 0.0), 3.0);
  return a * (0.006 + 0.014 * g) + a.zxy * 0.02 * haze;
}

vec3 renderRay(vec3 ro, vec3 rd) {
  vec3 col = vec3(0.0);
  float glow = 0.0;
  bool anyHit = false;

  float b = dot(ro, rd);
  float c = dot(ro, ro) - BOUND * BOUND;
  float disc = b * b - c;

  if (disc > 0.0) {
    float sq = sqrt(disc);
    float t = max(0.0, -b - sq);
    float tmax = -b + sq;
    bool hit = false;

    for (int i = 0; i < MAXS; i++) {
      if (i >= uSteps) break;
      float h = map(ro + rd * t);
      glow += exp(-12.0 * max(h, 0.0));
      if (h < uEps * t) { hit = true; break; }
      t += h * 0.9;
      if (t > tmax) break;
    }

    if (hit) {
      anyHit = true;
      vec3 p = ro + rd * t;
      map(p);
      vec4 tr = gTrap;
      vec3 n = calcNormal(p, t);

      if (uDetail >= 3) {
        vec3 q = p * 38.0 + tr.xyz * 6.0;
        n = normalize(n + 0.045 * vec3(sin(q.y + q.z * 0.7), sin(q.z + q.x * 0.7), sin(q.x + q.y * 0.7)));
      }

      vec3 albedo = palette(tr);
      vec3 hue2 = 0.5 + 0.5 * cos(6.2832 * (dot(n, vec3(0.35, 0.55, 0.75)) * 0.5 + length(p) * 0.35 + vec3(0.0, 0.33, 0.67) + time * 0.04));
      albedo = mix(albedo, hue2, 0.35);
      vec3 l1 = lightDir();
      vec3 l2 = normalize(vec3(-0.7, 0.2, 0.5));
      vec3 l3 = normalize(vec3(0.2, -0.8, -0.5));

      float sh = 1.0;
      if (uShadow > 0) sh = softShadow(p + n * 0.002, l1);
      float ao = 1.0;
      if (uAO > 0) ao = calcAO(p, n);

      float ndl = dot(n, l1);
      float dif = clamp(ndl, 0.0, 1.0) * sh;
      if (uDetail >= 3) dif = mix(dif, clamp((ndl + 0.35) / 1.35, 0.0, 1.0) * sh, 0.35);
      float fil = clamp(dot(n, l2), 0.0, 1.0);
      float amb = 0.5 + 0.5 * n.y;
      float spe = pow(clamp(dot(n, normalize(l1 - rd)), 0.0, 1.0), 32.0) * dif;
      float fre = pow(1.0 - clamp(dot(n, -rd), 0.0, 1.0), 3.0);

      vec3 emis = vec3(0.0);
      if (uDetail >= 1) {
        float wave = 0.5 + 0.5 * sin(tr.w * 22.0 - time * 1.8 + tr.x * 6.0);
        float vein = pow(wave, 12.0);
        vec3 vc = 0.5 + 0.5 * cos(6.2832 * (tr.w * 0.6 + vec3(0.0, 0.33, 0.67) + time * 0.1));
        emis = vc * vein * (0.55 + 0.45 * sin(time * 0.7 + tr.y * 5.0)) * 1.7;
        if (uDetail >= 2) {
          float wave2 = 0.5 + 0.5 * sin(tr.x * 18.0 + tr.z * 14.0 + time * 1.2);
          vec3 vc2 = 0.5 + 0.5 * cos(6.2832 * (tr.x * 0.8 + vec3(0.5, 0.83, 0.17) - time * 0.08));
          emis += vc2 * pow(wave2, 16.0) * 1.2;
        }
      }

      col = albedo * (vec3(1.0, 0.9, 0.75) * dif * 1.6
                    + vec3(0.20, 0.25, 0.42) * amb * ao * 0.9
                    + vec3(0.45, 0.20, 0.32) * fil * ao * 0.5);
      col += vec3(1.0, 0.92, 0.82) * spe * 0.5;
      vec3 frec = 0.5 + 0.5 * cos(6.2832 * (fre * 1.2 + tr.w * 0.7 + vec3(0.0, 0.33, 0.67) + time * 0.06));
      col += (vec3(0.30, 0.50, 1.00) * 0.35 + frec * 0.7) * fre * ao;
      col += albedo * vec3(0.10, 0.55, 0.65) * clamp(dot(n, l3), 0.0, 1.0) * ao * 0.6;
      col += emis * (0.5 + 0.8 * ao);

      vec3 rr = reflect(rd, n);
      vec3 envc = envMap(rr);
      float ndv = clamp(dot(n, -rd), 0.0, 1.0);
      float F = 0.10 + 0.90 * pow(1.0 - ndv, 4.0);
      float envMask = 1.0;

      if (uRefl > 0) {
        vec3 ro2 = p + n * 0.004;
        float t2 = 0.004;
        bool h2 = false;
        for (int i = 0; i < 128; i++) {
          if (i >= uRefl) break;
          float h = map(ro2 + rr * t2);
          if (h < 0.0008 * (1.0 + t2)) { h2 = true; break; }
          t2 += h * 0.9;
          if (t2 > 3.0) break;
        }
        if (h2) {
          vec3 p2 = ro2 + rr * t2;
          map(p2);
          vec4 tr2 = gTrap;
          vec3 n2 = calcNormal(p2, t2);
          vec3 rc = palette(tr2) * (0.12 + 0.88 * clamp(dot(n2, l1), 0.0, 1.0));
          col += rc * (0.08 + 0.7 * F) * ao * uGloss;
          envMask = 0.0;
        }
      }

      // heavy mirror reflection of the environment, tinted by the surface colour
      vec3 tint = mix(vec3(1.0), albedo * 1.6, 0.55);
      col += envc * tint * F * 1.25 * ao * envMask * uGloss;

      // hot specular highlights from the three lights
      vec3 hv = normalize(l1 - rd);
      float nh = clamp(dot(n, hv), 0.0, 1.0);
      col += vec3(1.0, 0.96, 0.90) * (pow(nh, 260.0) * 7.0 + pow(nh, 40.0) * 0.8) * sh * (0.5 + 0.5 * F) * uGloss;
      float nh2 = clamp(dot(n, normalize(l2 - rd)), 0.0, 1.0);
      col += vec3(1.0, 0.40, 0.80) * pow(nh2, 120.0) * 2.5 * ao * uGloss;
      float nh3 = clamp(dot(n, normalize(l3 - rd)), 0.0, 1.0);
      col += vec3(0.30, 0.90, 1.00) * pow(nh3, 120.0) * 2.5 * ao * uGloss;

      col *= exp(-0.008 * t * t);
    }
  }

  if (!anyHit) col += bgColor(rd);
  vec3 gc = 0.5 + 0.5 * cos(6.2832 * (vec3(0.6, 0.75, 0.9) + time * 0.03 + rd.x * 0.4));
  col += gc * glow * uGlow * (1.3 / float(uSteps));
  return col;
}

float hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }

void main() {
  vec3 acc = vec3(0.0);
  for (int a = 0; a < 4; a++) {
    if (a >= uAA) break;
    vec2 j = vec2(0.0);
    if (uAA > 1) {
      if (a == 0) j = vec2(-0.125, -0.375);
      else if (a == 1) j = vec2(0.375, -0.125);
      else if (a == 2) j = vec2(0.125, 0.375);
      else j = vec2(-0.375, 0.125);
    }
    vec3 rd = normalize(dir + dx * j.x + dy * j.y);
    acc += renderRay(origin, rd);
  }
  vec3 col = pow(clamp(acc / float(uAA), 0.0, 1.0), vec3(0.4545));
  col += (hash(gl_FragCoord.xy) - 0.5) / 255.0 * step(0.004, dot(col, vec3(1.0)));
  gl_FragColor = vec4(max(col, 0.0), 1.0);
}
`;

/* ---------------- quality presets ---------------- */
/* cx  = geometric complexity passed to the kernel as uComplex (0..4)
   ts  = animation time multiplier (each preset has its own pace)
   sp  = auto-spin speed while idle                                     */
const KEYS = ["low", "medium", "high", "ultra", "extreme"];
const PRESETS = {
  low:     { iter: 7,  steps: 110,  shadow: 0,  ao: 0, aa: 1, detail: 0, refl: 0,   eps: 0.0014,  res: 0.5,  w: 1,  cx: 0, ts: 0.35, sp: 0.04 },
  medium:  { iter: 9,  steps: 150, shadow: 20, ao: 3, aa: 1, detail: 1, refl: 0,   eps: 0.0008,  res: 0.75, w: 2,  cx: 1, ts: 0.7,  sp: 0.10 },
  high:    { iter: 11, steps: 210, shadow: 32, ao: 5, aa: 1, detail: 2, refl: 0,   eps: 0.0004,  res: 1.0,  w: 4,  cx: 2, ts: 1.1,  sp: 0.18 },
  ultra:   { iter: 13, steps: 280, shadow: 48, ao: 6, aa: 2, detail: 3, refl: 64,  eps: 0.00022, res: 1.0,  w: 8,  cx: 3, ts: 1.6,  sp: 0.28 },
  extreme: { iter: 15, steps: 320, shadow: 64, ao: 8, aa: 4, detail: 4, refl: 112, eps: 0.00012, res: 1.0,  w: 16, cx: 4, ts: 2.2,  sp: 0.40 }
};
/* target uPresetT for each preset, used for smooth blending */
const PRESET_T = { low: 0.0, medium: 0.25, high: 0.5, ultra: 0.75, extreme: 1.0 };
/* which presets should show a warning banner, and at what level */
const PRESET_WARN = { high: "high", ultra: "ultra", extreme: "extreme" };

